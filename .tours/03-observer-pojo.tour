    {
      "file": "customers/customers-api-observer-pojo/src/main/java/net/chrisrichardson/examples/monolithiccustomersandorders/customers/api/observer/pojo/CustomerDomainObservers.java",
      "description": "The `customers` domain publishes events via the Observer pattern.\nObservers register by calling `registerObserver()`, which is defined by the `CustomerDomainObservers` interface.\n\nThis interface is in the `customers-api-observer-pojo` Gradle subproject, which is another Domain API module for the `customers` domain.",
      "line": 5
    },
    {
      "file": "notifications/notifications-customer-observer-pojo-adapter/src/main/java/net/chrisrichardson/examples/monolithiccustomersandorders/notifications/customerobserver/pojoadapter/CustomerDomainObserverPojoAdapterConfiguration.java",
      "description": "One observer is the `notifications` domain module.\n\nBy default, the `notifications-customer-observer-pojo-adapter` Gradle subproject registers a `CustomerDomainObserverPojoAdapter`.\nAs a result, `notifications-domain` doesn't depend on the `customers` domain module.\n\nThis runs while the Spring application context is being created, before the web server accepts requests.\nAs a result, `notifications` is registered before any customer can be created.",
      "line": 17
    },
    {
      "file": "customers/customers-domain/src/main/java/net/chrisrichardson/examples/monolithiccustomersandorders/customers/domain/CustomerDomainObserversImpl.java",
      "description": "`CustomerDomainObserversImpl`, in `customers-domain`, implements `CustomerDomainObservers`.\nIt adds each registered observer to a list.",
      "line": 17
    },
